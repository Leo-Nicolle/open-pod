# Copy to sync/.env and edit. Values with spaces must be quoted.
# The real environment takes precedence over these values.

# Source music library
OPENPOD_LIBRARY=/home/leo/Music

# Mounted SD card
OPENPOD_SD=/mnt/openpod

# Persistent staging directory (default: <repo>/sync/staging)
# OPENPOD_STAGING=/home/leo/Documents/dev/open-pod/sync/staging

# Folders to skip, as ':'-separated paths relative to the library root.
# (See also sync/exclude.txt for one-path-per-line.)
# OPENPOD_EXCLUDE="Podcasts/Audiobooks:Various Artists/Bootlegs"
