{
  "name": "Openpod-docs",
  "scripts": {
    "publish": "gh-pages -d .vitepress/dist",
    "prepublish": "npm run sync-app && npm run docs:build",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "sync-app": "npm --prefix ../syncer/app run build:web"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "vitepress": "^2.0.0-alpha.5"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "naive-ui": "^2.41.0"
  }
}
