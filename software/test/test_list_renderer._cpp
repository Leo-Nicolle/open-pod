// test/test_list_renderer.cpp
#include <doctest.h>
#include "../src/ui/list/list_cache.hpp"
#include "../src/ui/list/list_renderer.hpp"
#include "../src/ui/list/utils.h"
#include "../src/fonts/IBMPlexSans16Bold.h"
#include "./mock_ui_types.h"

class ListRendererTestFixture {
public:
    ListCache* cache;
    ListRenderer* renderer;
    uint8_t* testBuffer;
    int bufferSize;
    
    ListRendererTestFixture() {
        // Test with 2 bits per pixel
        cache = new ListCache(IBMPlexSans16Bold, 2);
        renderer = new ListRenderer(*cache);
        
        // Allocate test buffer
        int width = 100;
        int height = 30;
        bufferSize = calculateBufferSize(width, height, 2);
        testBuffer = new uint8_t[bufferSize];
        memset(testBuffer, 0, bufferSize);
    }
    
    ~ListRendererTestFixture() {
        delete renderer;
        delete cache;
        delete[] testBuffer;
    }
};

TEST_CASE_FIXTURE(ListRendererTestFixture, "Constructor") {
    CHECK_EQ(2, cache->getBitsPerPixel());
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Buffer size calculation") {
    SUBCASE("1 bit per pixel") {
        int size1 = calculateBufferSize(100, 30, 1);
        CHECK_EQ((100 * 30 + 7) / 8, size1);
    }
    
    SUBCASE("2 bits per pixel") {
        int size2 = calculateBufferSize(100, 30, 2);
        CHECK_EQ((100 * 30 * 2 + 7) / 8, size2);
    }
    
    SUBCASE("4 bits per pixel") {
        int size4 = calculateBufferSize(100, 30, 4);
        CHECK_EQ((100 * 30 * 4 + 7) / 8, size4);
    }
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Bits per pixel validation") {
    // Bits per pixel is now taken from cache and set at construction
    // No runtime changes allowed - test the cache instead
    CHECK_EQ(2, cache->getBitsPerPixel());
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Binary render basic") {
    const char* testText = "Test Track";
    
    cache->renderElementBinary(testText, testBuffer);
    
    // Buffer should not be all zeros after rendering
    bool hasNonZero = false;
    for (int i = 0; i < bufferSize; i++) {
        if (testBuffer[i] != 0) {
            hasNonZero = true;
            break;
        }
    }
    CHECK(hasNonZero);
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Binary pixel operations") {
    // Create a small test binary buffer
    int testWidth = 8;
    int testHeight = 4;
    int testSize = calculateBufferSize(testWidth, testHeight, 2);
    uint8_t* binaryTest = new uint8_t[testSize];
    memset(binaryTest, 0, testSize);
    
    // Create display buffer
    uint16_t* displayBuffer = new uint16_t[testWidth * testHeight];
    
    // Test rendering binary to display using the renderer
    renderer->renderRect(0, 0, testWidth, testHeight, displayBuffer, -1);
    
    // All pixels should be valid colors
    for (int i = 0; i < testWidth * testHeight; i++) {
        CHECK_LE(displayBuffer[i], 0xFFFF);
    }
    
    delete[] binaryTest;
    delete[] displayBuffer;
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Color blending") {
    // Test color blending by rendering a pattern and checking results
    uint16_t* displayBuffer = new uint16_t[100 * 30];
    
    // Test rendering with the renderer
    renderer->renderRect(0, 0, 100, 30, displayBuffer, -1);
    
    // Should render without errors
    bool hasValidColors = true;
    for (int i = 0; i < 100 * 30; i++) {
        // Just check that we get valid color values
        if (displayBuffer[i] > 0xFFFF) {
            hasValidColors = false;
            break;
        }
    }
    CHECK(hasValidColors);
    
    delete[] displayBuffer;
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Gradient effect") {
    uint16_t* displayBuffer = new uint16_t[100 * 30];
    
    // Test with selected row to enable gradient
    renderer->renderRect(0, 0, 100, 30, displayBuffer, 0);
    
    // Should render without errors
    bool hasValidColors = true;
    for (int i = 0; i < 100 * 30; i++) {
        if (displayBuffer[i] > 0xFFFF) {
            hasValidColors = false;
            break;
        }
    }
    CHECK(hasValidColors);
    
    delete[] displayBuffer;
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Empty text rendering") {
    const char* emptyText = "";
    
    cache->renderElementBinary(emptyText, testBuffer);
    
    // Buffer should be mostly zeros for empty text
    int nonZeroCount = 0;
    for (int i = 0; i < bufferSize; i++) {
        if (testBuffer[i] != 0) nonZeroCount++;
    }
    
    // Allow some non-zero bytes due to potential initialization, but should be minimal
    CHECK_LT(nonZeroCount, bufferSize / 10);
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Long text rendering") {
    const char* longText = "This is a very long track name that should be clipped or handled properly by the renderer";
    
    cache->renderElementBinary(longText, testBuffer);
    
    // Should not crash and should produce some output
    bool hasContent = false;
    for (int i = 0; i < bufferSize; i++) {
        if (testBuffer[i] != 0) {
            hasContent = true;
            break;
        }
    }
    CHECK(hasContent);
}

TEST_CASE_FIXTURE(ListRendererTestFixture, "Offset rendering") {
    const char* testText = "Offset Test";
    int offset = 25; // Start rendering from middle
    
    cache->renderElementBinary(testText, testBuffer, offset);
    
    // Should still produce output even with offset
    bool hasContent = false;
    for (int i = 0; i < bufferSize; i++) {
        if (testBuffer[i] != 0) {
            hasContent = true;
            break;
        }
    }
    CHECK(hasContent);
}